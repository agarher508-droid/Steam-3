<!DOCTYPE html>
<html lang="es">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=1.0, user-scalable=no">
  <title>Préstamo Material STEAM - CEIP Toxiria</title>
  <script src="https://cdn.tailwindcss.com"></script>
  <script src="https://unpkg.com/html5-qrcode"></script>
  <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
  <style>
    body { background-color: #0f172a; color: #f8fafc; font-family: system-ui, -apple-system, sans-serif; }
    .nav-active { color: #38bdf8; border-top: 2px solid #38bdf8; }
    video { width: 100% !important; height: 100% !important; object-fit: cover; border-radius: 0.75rem; }
  </style>
</head>
<body class="pb-20 max-w-md mx-auto min-h-screen relative border-x border-slate-800 shadow-2xl">

  <header class="bg-slate-900 border-b border-slate-800 p-4 sticky top-0 z-50 flex items-center justify-between">
    <div class="flex items-center space-x-3">
      <div class="bg-sky-500 text-slate-950 p-2 rounded-xl font-bold">
        <i class="fa-solid fa-microchip text-xl"></i>
      </div>
      <div>
        <h1 class="font-bold text-base leading-tight">STEAM Toxiria</h1>
        <p class="text-xs text-slate-400">CEIP Toxiria · Préstamos & Aula</p>
      </div>
    </div>
    <span class="bg-emerald-500/10 text-emerald-400 text-xs px-2.5 py-1 rounded-full border border-emerald-500/20 font-medium">Auto-Redirect</span>
  </header>

  <main id="app-content" class="p-4 space-y-4"></main>

  <nav class="fixed bottom-0 left-1/2 -translate-x-1/2 w-full max-w-md bg-slate-900/95 backdrop-blur border-t border-slate-800 flex justify-around py-2 z-50 text-slate-400 text-xs">
    <button onclick="switchTab('scanner')" id="nav-scanner" class="flex flex-col items-center py-1 px-3 space-y-1 nav-active">
      <i class="fa-solid fa-qrcode text-lg"></i>
      <span>Escáner</span>
    </button>
    <button onclick="switchTab('prestar')" id="nav-prestar" class="flex flex-col items-center py-1 px-3 space-y-1">
      <i class="fa-solid fa-hand-holding-hand text-lg"></i>
      <span>Prestar</span>
    </button>
    <button onclick="switchTab('devolver')" id="nav-devolver" class="flex flex-col items-center py-1 px-3 space-y-1">
      <i class="fa-solid fa-rotate-left text-lg"></i>
      <span>Devolver</span>
    </button>
    <button onclick="switchTab('aula')" id="nav-aula" class="flex flex-col items-center py-1 px-3 space-y-1">
      <i class="fa-solid fa-calendar-days text-lg"></i>
      <span>Aula STEAM</span>
    </button>
  </nav>

  <script>
    let currentTab = 'scanner';
    let videoStream = null;

    function switchTab(tab) {
      stopCamera();
      currentTab = tab;
      document.querySelectorAll('nav button').forEach(b => b.classList.remove('nav-active'));
      document.getElementById('nav-' + tab).classList.add('nav-active');
      render();
    }

    function stopCamera() {
      if (videoStream) {
        videoStream.getTracks().forEach(track => track.stop());
        videoStream = null;
      }
    }

    function render() {
      const container = document.getElementById('app-content');
      if (currentTab === 'scanner') {
        container.innerHTML = `
          <div class="bg-slate-900 border border-slate-800 rounded-2xl p-4 text-center space-y-4">
            <h2 class="font-bold text-lg text-slate-100">Escáner de Equipos</h2>
            <p class="text-xs text-slate-400">Escanea el QR para ir directamente al préstamo</p>
            
            <div id="video-box" class="w-full bg-slate-950 rounded-xl border border-slate-800 h-64 overflow-hidden flex flex-col items-center justify-center relative">
              <video id="ipad-video" playsinline autoplay muted class="hidden"></video>
              <div id="video-placeholder" class="space-y-2">
                <i class="fa-solid fa-camera text-4xl text-slate-600"></i>
                <p class="text-xs text-slate-500">Haz clic abajo para encender la cámara</p>
              </div>
            </div>

            <div class="space-y-2">
              <button onclick="startIpadCamera()" class="w-full bg-sky-500 hover:bg-sky-400 text-slate-950 py-3 rounded-xl text-sm font-bold shadow-lg">
                <i class="fa-solid fa-video mr-1.5"></i> Encender Cámara iPad
              </button>
              
              <div class="flex space-x-2">
                <input type="file" id="qr-input-file" accept="image/*" class="hidden" onchange="scanImage(event)">
                <button onclick="document.getElementById('qr-input-file').click()" class="w-full bg-slate-800 text-slate-200 py-2.5 rounded-xl text-sm border border-slate-700">
                  <i class="fa-solid fa-camera-retro mr-1 text-sky-400"></i> Foto de QR directa
                </button>
              </div>
            </div>

            <div class="pt-3 border-t border-slate-800 text-left">
              <p class="text-[11px] font-semibold text-slate-400 uppercase mb-2">Simular lectura directa:</p>
              <div class="flex flex-wrap gap-1.5">
                <button onclick="onCodeScanned('CHROME-003')" class="px-2.5 py-1 bg-slate-800 text-sky-400 rounded text-xs font-mono">CHROME-003</button>
                <button onclick="onCodeScanned('MIC-001')" class="px-2.5 py-1 bg-slate-800 text-sky-400 rounded text-xs font-mono">MIC-001</button>
                <button onclick="onCodeScanned('PORT-001')" class="px-2.5 py-1 bg-slate-800 text-sky-400 rounded text-xs font-mono">PORT-001</button>
              </div>
            </div>
          </div>
        `;
      } else if (currentTab === 'prestar') {
        container.innerHTML = `
          <div class="bg-slate-900 border border-slate-800 rounded-2xl p-4 space-y-3">
            <h2 class="font-bold text-lg">Nuevo Préstamo</h2>
            <div>
              <label class="text-xs text-slate-400 block mb-1">Código del Equipo</label>
              <input type="text" id="equipo-code" placeholder="Ej. CHROME-001" class="w-full bg-slate-950 border border-sky-500/50 text-sky-400 font-bold rounded-xl p-3 text-sm font-mono">
            </div>
            <div>
              <label class="text-xs text-slate-400 block mb-1">Docente / Profesor/a</label>
              <input type="text" id="docente-name" placeholder="Nombre del profesor/a" class="w-full bg-slate-950 border border-slate-800 rounded-xl p-3 text-sm">
            </div>
            <button onclick="confirmarPrestamo()" class="w-full bg-sky-500 hover:bg-sky-400 text-slate-950 font-bold py-3 rounded-xl text-sm mt-2">
              Confirmar Préstamo
            </button>
          </div>
        `;
      } else if (currentTab === 'devolver') {
        container.innerHTML = `<div class="bg-slate-900 border border-slate-800 rounded-2xl p-4"><h2 class="font-bold text-lg">Devoluciones</h2><p class="text-xs text-slate-400 mt-2">Sin préstamos activos.</p></div>`;
      } else if (currentTab === 'aula') {
        container.innerHTML = `<div class="bg-slate-900 border border-slate-800 rounded-2xl p-4"><h2 class="font-bold text-lg">Aula STEAM</h2><p class="text-xs text-slate-400 mt-2">Horario de reservas disponible.</p></div>`;
      }
    }

    // Acción tras detectar el código QR
    function onCodeScanned(code) {
      stopCamera();
      switchTab('prestar');
      setTimeout(() => {
        const inputCode = document.getElementById('equipo-code');
        const inputDocente = document.getElementById('docente-name');
        if (inputCode) inputCode.value = code;
        if (inputDocente) inputDocente.focus();
      }, 150);
    }

    async function startIpadCamera() {
      const video = document.getElementById('ipad-video');
      const placeholder = document.getElementById('video-placeholder');
      
      try {
        stopCamera();
        videoStream = await navigator.mediaDevices.getUserMedia({
          video: { facingMode: { ideal: "environment" } },
          audio: false
        });
        video.srcObject = videoStream;
        video.classList.remove('hidden');
        placeholder.classList.add('hidden');
      } catch (err) {
        alert("Comprueba los permisos de cámara en Ajustes > Safari del iPad.");
      }
    }

    function scanImage(e) {
      if (!e.target.files || e.target.files.length === 0) return;
      const html5QrCode = new Html5Qrcode("video-box");
      html5QrCode.scanFile(e.target.files[0], true)
        .then(code => onCodeScanned(code))
        .catch(() => alert("No se pudo leer el código QR en esta foto."));
    }

    function confirmarPrestamo() {
      const doc = document.getElementById('docente-name').value;
      const eq = document.getElementById('equipo-code').value;
      if (!doc || !eq) {
        alert("Por favor completa el nombre del docente y el equipo.");
        return;
      }
      alert(`Préstamo registrado correctamente:\nEquipo: ${eq}\nDocente: ${doc}`);
      switchTab('scanner');
    }

    render();
  </script>
</body>
</html>
